generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName String
  email String @unique
  passwordHash String
  role String @default("CREDIT_OFFICER")
  active Boolean @default(true)
  assignedApplications LoanApplication[] @relation("AssignedOfficer")
  decisions LoanDecision[]
  reconsiderations Reconsideration[] @relation("ReconsiderationOfficer")
  verifications ApplicationVerification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Applicant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  documentType String
  documentNumber String @unique
  firstName String
  lastName String
  birthDate DateTime?
  email String?
  phone String?
  address String?
  municipality String?
  residenceZone String?
  occupation String?
  activityDuration String?
  dependents Int @default(0)
  hasExistingDebts Boolean @default(false)
  monthlyIncome Float?
  monthlyExpenses Float?
  monthlyDebtPayments Float @default(0)
  applications LoanApplication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model LoanApplication {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationNumber String @unique
  applicantId String @db.ObjectId
  applicant Applicant @relation(fields: [applicantId], references: [id])
  assignedOfficerId String? @db.ObjectId
  assignedOfficer User? @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  assignedAt DateTime?
  trackingCredential ApplicationTrackingCredential?
  applicantSnapshot ApplicationApplicantSnapshot?
  verification ApplicationVerification?
  requestedAmount Float
  requestedTerm Int
  purpose String
  status String @default("PENDING_ASSIGNMENT")
  evaluations RiskEvaluation[]
  decisions LoanDecision[]
  reconsideration Reconsideration?
  loan Loan?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([assignedOfficerId, status])
}
model CreditPolicy {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  version Int
  description String?
  minimumAge Int?
  maximumAmount Float?
  maximumTermMonths Int?
  maxDebtRatio Float?
  annualInterestRate Float?
  maximumSimultaneousLoans Int?
  allowedPurposes String[] @default([])
  requireVerifiedResidence Boolean @default(true)
  effectiveFrom DateTime
  effectiveUntil DateTime?
  active Boolean @default(true)
  evaluations RiskEvaluation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, version])
}
model RiskEvaluation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  policyId String @db.ObjectId
  policy CreditPolicy @relation(fields: [policyId], references: [id])
  monthlyIncome Float
  monthlyExpenses Float
  existingObligations Float @default(0)
  estimatedInstallment Float?
  debtToIncomeRatio Float?
  indicators Json
  result String
  observations String?
  evaluatedAt DateTime @default(now())
}
model LoanDecision {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  officerId String @db.ObjectId
  officer User @relation(fields: [officerId], references: [id])
  outcome String
  justification String
  conditions String?
  decidedAt DateTime @default(now())
}
model Loan {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  loanNumber String @unique
  applicationId String @unique @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  principal Float
  annualRate Float
  termMonths Int
  status String @default("PENDING_DISBURSEMENT")
  disbursementDate DateTime?
  paymentSchedules PaymentSchedule[]
  payments Payment[]
  alerts Alert[]
  collectionActions CollectionAction[]
  restructurings LoanRestructuring[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentSchedule {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  loanId String @db.ObjectId
  loan Loan @relation(fields: [loanId], references: [id])
  installment Int
  scheduleVersion Int @default(1)
  isCurrent Boolean @default(true)
  dueDate DateTime
  principal Float
  interest Float
  totalDue Float
  balance Float
  paidAmount Float @default(0)
  paidAt DateTime?
  status String @default("PENDING")
  alerts Alert[]
  createdAt DateTime @default(now())
  @@unique([loanId, scheduleVersion, installment])
  @@index([loanId, isCurrent, installment])
}
model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  loanId String @db.ObjectId
  loan Loan @relation(fields: [loanId], references: [id])
  amount Float
  paymentDate DateTime
  reference String?
  status String @default("CONFIRMED")
  recordedById String @db.ObjectId
  notes String?
  allocations Json?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  actorId String?
  action String
  entityType String
  entityId String
  description String
  metadata Json?
  occurredAt DateTime @default(now())
}
model ApplicationTrackingCredential {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @unique @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  tokenHash String @unique
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
}
model ApplicationApplicantSnapshot {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @unique @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  documentType String
  documentNumber String
  firstName String
  lastName String
  birthDate DateTime
  phone String
  address String?
  municipality String
  residenceZone String
  occupation String
  activityDuration String
  monthlyIncome Float
  monthlyExpenses Float
  dependents Int
  hasExistingDebts Boolean
  monthlyDebtPayments Float
  submittedAt DateTime @default(now())
}
model ApplicationVerification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @unique @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  verified Boolean
  notes String
  verifiedById String @db.ObjectId
  verifiedBy User @relation(fields: [verifiedById], references: [id])
  verifiedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}


model Reconsideration {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @unique @db.ObjectId
  application LoanApplication @relation(fields: [applicationId], references: [id])
  originalDecisionId String @db.ObjectId
  originalOfficerId String @db.ObjectId
  assignedOfficerId String @db.ObjectId
  assignedOfficer User @relation("ReconsiderationOfficer", fields: [assignedOfficerId], references: [id])
  applicantMessage String
  status String @default("PENDING_REVIEW")
  outcome String?
  justification String?
  submittedAt DateTime @default(now())
  decidedAt DateTime?
  @@index([assignedOfficerId, status, submittedAt])
}


model Alert {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  loanId String @db.ObjectId
  loan Loan @relation(fields: [loanId], references: [id])
  scheduleId String @db.ObjectId
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id])
  type String
  referenceDate DateTime
  daysOffset Int
  title String
  message String
  status String @default("UNREAD")
  createdAt DateTime @default(now())
  readAt DateTime?
  @@unique([scheduleId, type, referenceDate])
  @@index([status, createdAt])
}


model CollectionAction {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  loanId String @db.ObjectId
  loan Loan @relation(fields: [loanId], references: [id])
  description String
  result String?
  performedAt DateTime @default(now())
  recordedById String @db.ObjectId
  createdAt DateTime @default(now())
  @@index([loanId, performedAt])
}


model RestructuringPolicy {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  version Int
  maximumTermMonths Int
  maximumGracePeriodDays Int
  maximumUsuryRate Float
  maximumOfficerApprovalAmount Float
  allowRateChange Boolean
  allowRepeatedRestructuring Boolean
  maximumRestructurings Int
  overdueInstallmentsTreatment String
  includeAccruedInterest Boolean
  lateInterestTreatment String
  effectiveFrom DateTime
  effectiveUntil DateTime?
  active Boolean @default(true)
  restructurings LoanRestructuring[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, version])
  @@index([active, effectiveFrom])
}

model LoanRestructuring {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  loanId String @db.ObjectId
  loan Loan @relation(fields: [loanId], references: [id])
  policyId String @db.ObjectId
  policy RestructuringPolicy @relation(fields: [policyId], references: [id])
  version Int
  status String @default("PENDING_REVIEW")
  reason String
  requestedById String
  reviewedById String?
  acceptedById String?
  decision String?
  justification String?
  principalOutstanding Float
  accruedInterestOutstanding Float
  includedInterest Float
  lateInterestAmount Float
  lateInterestEvidence String?
  waivedInterest Float
  newPrincipal Float
  previousAnnualRate Float
  proposedAnnualRate Float
  previousTermMonths Int
  proposedTermMonths Int
  gracePeriodDays Int
  firstDueDate DateTime
  overdueBalance Float
  acceptanceMethod String?
  acceptanceEvidence String?
  acceptedAt DateTime?
  decidedAt DateTime?
  activatedAt DateTime?
  scheduleVersion Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([loanId, version])
  @@index([loanId, status, createdAt])
  @@index([status, createdAt])
}
